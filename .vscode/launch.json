{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Chat pi Runtime (9230)",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9230,
      "timeout": 300000,
      "restart": true,
      "continueOnAttach": false,
      "preLaunchTask": "pi: build source for Chat debug",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/*/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
